<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.fs" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="FS.GG.Governance.Config" Version="[$(ConfigVersion)]" />
    <PackageReference Include="FS.GG.Contracts" Version="[$(ContractsVersion)]" />
    <PackageReference Include="YamlDotNet" Version="[$(YamlVersion)]" />
    <PackageReference Include="FSharp.Core" Version="[$(CoreVersion)]" />
  </ItemGroup>
</Project>
