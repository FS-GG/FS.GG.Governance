<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.config (repo root) — adds the org GitHub Packages NuGet feed ADDITIVELY; does NOT
     <clear/> inherited sources, so nuget.org still resolves the public packages (YamlDotNet,
     Expecto, …). FS.GG packages are dual-published (ADR-0012 / ADR-0039). This repository retains
     authenticated org-feed reads except for the exact public mappings below. Contracts and the
     published SDD dependency closure join Kit and Coord.Cli on the public read path (#484).
     Other FS.GG package identities retain their existing authenticated route.
     Credentials are env placeholders (NO secret is committed): locally export FSGG_PACKAGES_ACTOR +
     FSGG_PACKAGES_READ_TOKEN (a PAT with read:packages); in CI they are wired from GITHUB_TOKEN with
     `permissions: packages: read` (see .github/workflows/gate.yml). -->
<configuration>
  <packageSources>
    <add key="fsgg-github" value="https://nuget.pkg.github.com/FS-GG/index.json" protocolVersion="3" />
  </packageSources>
  <!-- CPM with >1 source requires explicit source mapping (NU1507). NuGet resolves a package
       against its LONGEST matching pattern, so the exact public ids below beat the authenticated
       FS.GG.* prefix and each resolve from nuget.org alone. The #484 public exceptions are explicit;
       it is not an authentication-failure fallback and does not change the route for other FS.GG ids.
       The FS.GG. prefix is reserved on nuget.org for the publishing
       account (ADR-0012 §5 anti-squat control, granted 2026-07-17). -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="FS.GG.Coord.Cli" />
      <package pattern="FS.GG.Contracts" />
      <package pattern="FS.GG.SDD.Commands" />
      <package pattern="FS.GG.SDD.Artifacts" />
      <package pattern="FS.GG.SDD.Knowledge" />
      <package pattern="FS.GG.Audio.Skills" />
      <package pattern="FS.GG.Drivers" />
      <package pattern="FS.GG.Game.Skills" />
      <package pattern="FS.GG.Governance.Config" />
      <package pattern="FS.GG.Rendering.Skills" />
      <!-- FS.GG.Kit is dual-published anonymously to nuget.org (ADR-0062 / .github#1262), exactly like
           FS.GG.Coord.Cli, so route its exact id here rather than to the credentialed org feed. The kit
           materialize (.config/kit/FS.GG.Kit.receiver.proj) then restores it with no credential. -->
      <package pattern="FS.GG.Kit" />
    </packageSource>
    <packageSource key="fsgg-github">
      <package pattern="FS.GG.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <fsgg-github>
      <add key="Username" value="%FSGG_PACKAGES_ACTOR%" />
      <add key="ClearTextPassword" value="%FSGG_PACKAGES_READ_TOKEN%" />
    </fsgg-github>
  </packageSourceCredentials>
</configuration>
